# ============================================================
# Ninas Fit — variables de entorno
# Copiá este archivo a .env.local y completá los valores.
# NUNCA commitees .env.local (tiene secretos).
# ============================================================

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Service role: SOLO se usa del lado del servidor (alta de miembros, reset de clave).
# Tiene permisos totales y saltea RLS. Jamás exponer al browser.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# --- Experiencia / expansión ---
# UUID de la fila de "Ninas Fit" en la tabla `lugares`.
# Hoy define el lugar anfitrión (protagonista). Para expandir a la red,
# se cambia esto + la pantalla de inicio (ver src/lib/config/experiencia.ts).
# El valor de abajo coincide con el que crea supabase/seed.sql.
NEXT_PUBLIC_LUGAR_ANFITRION_ID=11111111-1111-1111-1111-111111111111

# Dominio del email sintético interno para el login documento+clave de los miembros.
# No es un email real ni se le muestra a nadie: se arma como {dni}@ese-dominio.
NEXT_PUBLIC_EMAIL_DOMINIO_MIEMBROS=miembros.ninasfit.app
